    <worksheet name='Attrition by DOH'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='10'>Attrition by Distance From Home</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://public.tableau.com/workbooks/Book1_fixed3/AttritionbyAge?rev=' id='132394456' path='/workbooks/Book1_fixed3' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='WA_Fn-UseC_-HR-Employee-Attrition' name='federated.18q6bvc0192sac15eku9c0146us0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Department Filter' datatype='string' name='[Parameter 1089098379780098]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18q6bvc0192sac15eku9c0146us0'>
            <column datatype='string' name='[Attrition]' role='dimension' type='nominal' />
            <column caption='Department Selection' datatype='boolean' name='[Calculation_1089098383077380]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1089098379780098] = &quot;All&quot;&#13;&#10;OR&#13;&#10;[Department] = [Parameters].[Parameter 1089098379780098]' />
            </column>
            <column caption='Distance Group' datatype='string' name='[Calculation_1089098392170506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [DistanceFromHome] &lt;= 5 THEN &quot;0-5&quot;&#13;&#10;ELSEIF [DistanceFromHome] &lt;= 10 THEN &quot;6-10&quot;&#13;&#10;ELSEIF [DistanceFromHome] &lt;= 15 THEN &quot;11-15&quot;&#13;&#10;ELSEIF [DistanceFromHome] &lt;= 20 THEN &quot;16-20&quot;&#13;&#10;ELSE &quot;21+&quot;&#13;&#10;END' />
            </column>
            <column caption='Distance Attrition Rate' datatype='real' name='[Calculation_1089098392227851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Attrition] = &quot;Yes&quot; THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([EmployeeNumber])&#13;&#10;* 100' />
            </column>
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
            <column caption='Distance From Home' datatype='integer' name='[DistanceFromHome]' role='measure' type='quantitative' />
            <column caption='Employee Number' datatype='integer' name='[EmployeeNumber]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1089098383077380]' derivation='None' name='[none:Calculation_1089098383077380:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1089098392170506]' derivation='None' name='[none:Calculation_1089098392170506:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1089098392227851]' derivation='User' name='[usr:Calculation_1089098392227851:qk]' pivot='key' type='quantitative' />
