      <aliases enabled='yes' />
      <column caption='Business Travel' datatype='string' name='[BusinessTravel]' role='dimension' type='nominal' />
      <column caption='Department Selection' datatype='boolean' name='[Calculation_1089098383077380]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1089098379780098] = &quot;All&quot;&#13;&#10;OR&#13;&#10;[Department] = [Parameters].[Parameter 1089098379780098]' />
      </column>
      <column caption='Attrition Rate KPI' datatype='real' name='[Calculation_1089098385567749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Attrition] = &quot;Yes&quot; THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([EmployeeNumber])&#13;&#10;* 100' />
      </column>
      <column caption='Salary Group' datatype='string' name='[Calculation_1089098387238918]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [MonthlyIncome] &lt; 5000 THEN &quot;Low&quot;&#13;&#10;ELSEIF [MonthlyIncome] &lt;= 10000 THEN &quot;Medium&quot;&#13;&#10;ELSEIF [MonthlyIncome] &lt;= 15000 THEN &quot;High&quot;&#13;&#10;ELSE &quot;Very High&quot;&#13;&#10;END' />
      </column>
      <column caption='Salary Group Attrition Rate' datatype='real' name='[Calculation_1089098387734535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Attrition] = &quot;Yes&quot; THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([EmployeeNumber])&#13;&#10;* 100' />
      </column>
      <column caption='Age graph' datatype='string' name='[Calculation_1089098390290440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &gt;= 18 AND [Age] &lt;= 24 THEN &quot;18-24&quot;&#13;&#10;ELSEIF [Age] &gt;= 25 AND [Age] &lt;= 34 THEN &quot;26-34&quot;&#13;&#10;ELSEIF [Age] &gt;= 35 AND [Age] &lt;= 44 THEN &quot;36-44&quot;&#13;&#10;ELSEIF [Age] &gt;= 45 AND [Age] &lt;= 54 THEN &quot;46-54&quot;&#13;&#10;ELSE &quot;55+&quot;&#13;&#10;END' />
      </column>
      <column caption='Age Attrition Rate' datatype='real' name='[Calculation_1089098390523913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Attrition] = &quot;Yes&quot; THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([EmployeeNumber])&#13;&#10;* 100' />
      </column>
      <column caption='Distance Group' datatype='string' name='[Calculation_1089098392170506]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [DistanceFromHome] &lt;= 5 THEN &quot;0-5&quot;&#13;&#10;ELSEIF [DistanceFromHome] &lt;= 10 THEN &quot;6-10&quot;&#13;&#10;ELSEIF [DistanceFromHome] &lt;= 15 THEN &quot;11-15&quot;&#13;&#10;ELSEIF [DistanceFromHome] &lt;= 20 THEN &quot;16-20&quot;&#13;&#10;ELSE &quot;21+&quot;&#13;&#10;END' />
      </column>
      <column caption='Distance Attrition Rate' datatype='real' name='[Calculation_1089098392227851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Attrition] = &quot;Yes&quot; THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([EmployeeNumber])&#13;&#10;* 100' />
      </column>
      <column caption='Job Satisfaction Attrition Rate' datatype='real' name='[Calculation_1089098393317390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Attrition] = &quot;Yes&quot; THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([EmployeeNumber])&#13;&#10;* 100' />
      </column>
